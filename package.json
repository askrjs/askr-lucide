{
  "name": "@askrjs/lucide",
  "version": "0.2.1",
  "description": "Thin Askr wrappers for the Lucide SVG icon set",
  "keywords": [
    "askr",
    "askrjs",
    "components",
    "icons",
    "lucide",
    "svg"
  ],
  "homepage": "https://github.com/askrjs/askr-lucide#readme",
  "bugs": {
    "url": "https://github.com/askrjs/askr-lucide/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "askrjs",
    "url": "https://github.com/askrjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askrjs/askr-lucide.git"
  },
  "files": [
    "dist",
    "README.md",
    "capabilities.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./package.json": "./package.json",
    "./capabilities.json": "./capabilities.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run generate && vp pack",
    "dev": "npm run generate && vp pack --watch",
    "fmt": "vp fmt .",
    "generate": "node scripts/generate.js",
    "lint": "vp lint .",
    "typecheck": "npm run test:types",
    "test:publint": "publint",
    "pack:check": "node tests/package-artifacts.js",
    "test:installed": "node tests/installed-smoke.js",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:installed && npm run test:publint && npm run pack:check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "npm run test:unit",
    "test:coverage": "vp test run -c vitest.config.ts --coverage",
    "test:types": "npm run generate && tsc -p tsconfig.build.json --noEmit",
    "test:unit": "vp test run -c vitest.config.ts"
  },
  "devDependencies": {
    "@askrjs/askr": ">=0.2.0 <0.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "lucide": "1.30.0",
    "publint": "^0.3.23",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.8"
  },
  "peerDependencies": {
    "@askrjs/askr": ">=0.2.0 <0.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1"
}
